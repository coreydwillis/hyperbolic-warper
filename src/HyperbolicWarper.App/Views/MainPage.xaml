<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="HyperbolicWarper.App.Views.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:HyperbolicWarper.App.Converters"
    xmlns:viewmodels="using:HyperbolicWarper.App.ViewModels"
    xmlns:views="using:HyperbolicWarper.App.Views"
    xmlns:controls="using:HyperbolicWarper.App.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:StatusToProcessingBoolConverter x:Key="StatusToProcessingBool" />
        <converters:StatusToProcessingVisibilityConverter x:Key="StatusToProcessingVisibility" />
        <converters:StatusToIdleVisibilityConverter x:Key="StatusToIdleVisibility" />
        <converters:ShiftModeEqualsConverter x:Key="ModeEquals" />
    </Page.Resources>

    <!--
        RowSpacing intentionally 0: Grid.RowSpacing adds space between every row track regardless
        of whether the content in it is visible, so with InfoBar closed (its usual state) it was
        adding two stacked 12px gaps between the menu bar and the content below instead of one.
        Spacing is set explicitly per-element below instead, so the gap is a consistent 16px
        (matching the panels' own padding) whether or not the InfoBar is showing.
    -->
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open file(s)..." Click="OnAddFilesClicked" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="OnExitClicked" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="How Hyperbolic Warper works" Click="OnHowItWorksClicked" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About Hyperbolic Warper" Click="OnAboutClicked" />
            </MenuBarItem>
        </MenuBar>

        <InfoBar
            Grid.Row="1"
            Margin="16,0,16,0"
            Title="Some files were skipped"
            Message="{Binding ValidationMessage}"
            Severity="Warning"
            IsOpen="{Binding HasValidationMessage}" />

        <Grid Grid.Row="2" x:Name="ContentGrid" Padding="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SettingsColumn" Width="300" MinWidth="230" />
            </Grid.ColumnDefinitions>

            <!-- File list / drop zone -->
            <Border
                Grid.Column="0"
                Margin="0,0,10,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                AllowDrop="True"
                DragOver="OnDropZoneDragOver"
                Drop="OnDropZoneDrop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Add files" Click="OnAddFilesClicked" />
                        <Button Content="Clear" Command="{Binding ClearFilesCommand}" />
                        <TextBlock Text="or drag &amp; drop .srt files here" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{Binding Files}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,3" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:BatchFileViewModel">
                                <Border
                                    MinWidth="280"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,2">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                                <ProgressRing
                                                    IsActive="{Binding Status, Converter={StaticResource StatusToProcessingBool}}"
                                                    Visibility="{Binding Status, Converter={StaticResource StatusToProcessingVisibility}}"
                                                    Width="18"
                                                    Height="18" />
                                                <FontIcon
                                                    Glyph="{Binding StatusGlyph}"
                                                    Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                    FontSize="16"
                                                    Visibility="{Binding Status, Converter={StaticResource StatusToIdleVisibility}}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{Binding SummaryText}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Opacity="0.75"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="2"
                                                Content="Remove"
                                                VerticalAlignment="Center"
                                                Command="{Binding ElementName=RootPage, Path=DataContext.RemoveFileCommand}"
                                                CommandParameter="{Binding}" />
                                        </Grid>

                                        <Button
                                            Grid.Row="1"
                                            Content="Show in folder"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ShowInFolderCommand}"
                                            Visibility="{Binding OutputPath, Converter={StaticResource NullToVisibility}}" />

                                        <views:ShiftInputControl
                                            Grid.Row="2"
                                            Settings="{Binding Shift}"
                                            Visibility="{Binding ElementName=RootPage, Path=DataContext.PerFileShiftVisible, Converter={StaticResource BoolToVisibility}}" />

                                        <Expander
                                            Grid.Row="3"
                                            Header="Verification details"
                                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                            Visibility="{Binding Result, Converter={StaticResource NullToVisibility}}"
                                            HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch">
                                            <TextBlock
                                                Text="{Binding DetailsText}"
                                                TextWrapping="Wrap"
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="12" />
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <controls:SplitterHandle
                Grid.Column="1"
                x:Name="Splitter"
                Width="10"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="PanelSplitter"
                PointerEntered="OnSplitterPointerEntered"
                PointerExited="OnSplitterPointerExited"
                PointerPressed="OnSplitterPointerPressed"
                PointerMoved="OnSplitterPointerMoved"
                PointerReleased="OnSplitterPointerReleased"
                PointerCaptureLost="OnSplitterPointerCaptureLost">
                <Rectangle
                    x:Name="SplitterGrip"
                    Width="2"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.4"
                    RadiusX="1"
                    RadiusY="1" />
            </controls:SplitterHandle>

            <!-- Settings panel -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,0,12,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Mode" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <RadioButton
                                GroupName="ShiftMode"
                                Content="Shift by amount"
                                IsChecked="{Binding GlobalShift.Mode, Converter={StaticResource ModeEquals}, ConverterParameter=Relative, Mode=TwoWay}" />
                            <RadioButton
                                GroupName="ShiftMode"
                                Content="Set first timecode to"
                                IsChecked="{Binding GlobalShift.Mode, Converter={StaticResource ModeEquals}, ConverterParameter=SetFirstStart, Mode=TwoWay}" />
                        </StackPanel>

                        <CheckBox Content="Apply same shift to all files" IsChecked="{Binding ApplySameShiftToAllFiles, Mode=TwoWay}" />

                        <views:ShiftInputControl
                            Settings="{Binding GlobalShift}"
                            Visibility="{Binding ApplySameShiftToAllFiles, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock
                            Text="Each file in the list has its own shift controls below its name."
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            MaxWidth="260"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Visibility="{Binding ApplySameShiftToAllFiles, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                        <CheckBox Content="Overwrite original files" IsChecked="{Binding OverwriteOriginalFiles, Mode=TwoWay}" />

                        <Button
                            Content="Process files"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ProcessAllCommand}" />

                        <ProgressBar
                            Value="{Binding OverallProgress}"
                            Minimum="0"
                            Maximum="100"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxWidth="260" Opacity="0.8" />

                        <Button
                            Content="Save verification log..."
                            HorizontalAlignment="Stretch"
                            Click="OnSaveVerificationLogClicked"
                            Visibility="{Binding HasProcessedFiles, Converter={StaticResource BoolToVisibility}}" />

                        <Button
                            Content="Open verification log"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenVerificationLogClicked"
                            Visibility="{Binding LastVerificationLogPath, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
