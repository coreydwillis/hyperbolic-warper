<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="HyperbolicWarper.App.Views.ShiftInputControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:HyperbolicWarper.App.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ShiftModeToRelativeVisibilityConverter x:Key="RelativeVisibilityConverter" />
        <converters:ShiftModeToHeaderConverter x:Key="ShiftHeaderConverter" />
    </UserControl.Resources>

    <StackPanel x:Name="RootPanel" Spacing="8" MinWidth="230">
        <TextBlock
            Text="{Binding Mode, Converter={StaticResource ShiftHeaderConverter}}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Opacity="0.7" />
        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <NumberBox
                Grid.Row="0"
                Grid.Column="0"
                Header="Hours"
                Value="{Binding Hours, Mode=TwoWay}"
                Minimum="0"
                Maximum="999"
                SmallChange="1"
                SpinButtonPlacementMode="Compact"
                HorizontalAlignment="Stretch" />
            <NumberBox
                Grid.Row="0"
                Grid.Column="1"
                Header="Minutes"
                Value="{Binding Minutes, Mode=TwoWay}"
                Minimum="0"
                Maximum="59"
                SmallChange="1"
                SpinButtonPlacementMode="Compact"
                HorizontalAlignment="Stretch" />
            <NumberBox
                Grid.Row="1"
                Grid.Column="0"
                Header="Seconds"
                Value="{Binding Seconds, Mode=TwoWay}"
                Minimum="0"
                Maximum="59"
                SmallChange="1"
                SpinButtonPlacementMode="Compact"
                HorizontalAlignment="Stretch" />
            <NumberBox
                Grid.Row="1"
                Grid.Column="1"
                Header="Milliseconds"
                Value="{Binding Milliseconds, Mode=TwoWay}"
                Minimum="0"
                Maximum="999"
                SmallChange="1"
                SpinButtonPlacementMode="Compact"
                HorizontalAlignment="Stretch" />
        </Grid>
        <ToggleSwitch
            Header="Direction"
            OnContent="Forward (+)"
            OffContent="Backward (−)"
            IsOn="{Binding IsForward, Mode=TwoWay}"
            Visibility="{Binding Mode, Converter={StaticResource RelativeVisibilityConverter}}" />
    </StackPanel>
</UserControl>
